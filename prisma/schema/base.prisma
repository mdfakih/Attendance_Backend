// Shared generator, datasource and enums. Domain models live in sibling files.
// Conventions: snake_case tables/columns via @@map/@map, UUIDv7 ids, timestamptz in UTC,
// business dates as `date` in the tenant timezone, money as numeric(14,2).

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}


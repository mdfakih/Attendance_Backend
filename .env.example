# Copy to Backend/.env. Values for the local docker stack come from infra/.env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://attendance:change-me@127.0.0.1:5432/attendance
REDIS_URL=redis://:change-me@127.0.0.1:6379

# Neon Object Storage: S3_ENDPOINT = the branch's AWS_ENDPOINT_URL_S3, keys = the Neon storage credential,
# S3_REGION=ap-southeast-1, S3_BUCKET=attendance, S3_FORCE_PATH_STYLE=true (Neon requires path-style).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=attendance
S3_SECRET_KEY=change-me
S3_BUCKET=attendance-dev
S3_FORCE_PATH_STYLE=true

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="KamaiGo <no-reply@kamaigo.local>"

# One HS256 secret per auth realm (min 32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_EMPLOYEE=change-me-change-me-change-me-change-me
JWT_SECRET_TENANT=change-me-change-me-change-me-change-me
JWT_SECRET_PLATFORM=change-me-change-me-change-me-change-me

# Activation code HMAC pepper (versioned) and AES-256-GCM key (base64, 32 bytes) for reveal-while-live copies.
CODE_PEPPER_V1=change-me-change-me-change-me-change-me
CODE_ENC_KEY=change-me-base64-32-bytes
# HMAC key for device identifiers (ANDROID_ID).
DEVICE_ID_HMAC_KEY=change-me-change-me-change-me-change-me

WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: path to a Firebase service-account JSON for FCM push. Push is logged only when unset.
FCM_SERVICE_ACCOUNT_PATH=
# Optional: the same JSON inline (hosts without files, e.g. Vercel). Wins over the path.
FCM_SERVICE_ACCOUNT_JSON=

# Superadmin bootstrap used by `npm run seed` (development only).
SEED_SUPERADMIN_EMAIL=admin@platform.local
SEED_SUPERADMIN_PASSWORD=change-me-Pass123
